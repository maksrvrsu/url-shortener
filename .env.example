# Environment mode: local, dev, prod
ENV=local

# HTTP Server configuration
HTTP_SERVER_ADDRESS=0.0.0.0:8082
HTTP_SERVER_TIMEOUT=4s
HTTP_SERVER_IDLE_TIMEOUT=60s

# Basic Auth credentials
HTTP_SERVER_USER=admin
HTTP_SERVER_PASSWORD=secret

# PostgreSQL configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=url_shortener
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

# Database connection URL (used by the service and docker-compose)
DATABASE_URL=postgres://postgres:postgres@postgres:5432/url_shortener?sslmode=disable
